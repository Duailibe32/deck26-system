{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deck 26 PDV & Hotel Milla",
  "version": "1.0.0",
  "identifier": "br.com.deck26.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DECK 26 — Gestão Integrada Bar, Restaurante e Hotel Milla",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
