{
  "name": "deck26-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DECK 26 — Sistema Profissional de Gestão Integrada para Bar, Restaurante e Hotel (Hotel Auto Posto Milla)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run && npm run test:runtime",
    "test:runtime": "node --import tsx scripts/smoke-runtime.mjs",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:local-server": "npm --workspace=@deck26/local-server run dev",
    "dev:desktop": "npm --workspace=@deck26/desktop run dev",
    "dev:web": "npm --workspace=@deck26/web run dev",
    "dev:cloud-api": "npm --workspace=@deck26/cloud-api run dev",
    "build:windows:test": "node scripts/build-windows-test.mjs",
    "dev:windows:test:server": "node --import tsx scripts/start-windows-test.mjs",
    "build:windows:local": "node scripts/build-windows-local.mjs",
    "start:local": "node --import tsx scripts/start-local-operation.mjs",
    "start:fiscal:presentation": "node --import tsx scripts/start-fiscal-presentation.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
