# ============================================================================
# DECK 26 — MODELO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para ".env" localmente e preencha os valores necessários.
# NUNCA versione o arquivo ".env" real ou certificados fiscais no Git.
# ============================================================================

# Ambiente de Execução (development | test | production)
NODE_ENV=development

# Porta e Modo de Rede do Servidor Operacional Local
PORT=4000
HOST=127.0.0.1
# Altere para true somente quando quiser liberar acesso na rede Wi-Fi local para os celulares dos garçons
DECK26_ENABLE_LAN=false

# Caminhos Relativos dos Bancos de Dados Persistentes (Independentes)
DECK26_LOCAL_DB_PATH=./data/deck26-local.sqlite
DECK26_CLOUD_DB_PATH=./data/deck26-cloud-vps.sqlite

# Porta e URL do Servidor de Nuvem (Simulador Local ou futura Hostinger VPS)
CLOUD_PORT=4100
DECK26_CLOUD_API_URL=http://127.0.0.1:4100

# Chave HMAC para Assinatura de Sessão Local e QR Codes (Obrigatória em produção; gere uma chave aleatória forte)
DECK26_AUTH_SECRET=
DECK26_QR_SEED_SECRET=

# Configuração Futura de PostgreSQL (Opcional para Docker ou Hostinger VPS)
# DATABASE_URL=
POSTGRES_PORT=5432
POSTGRES_DB=deck26_cloud
POSTGRES_USER=deck26_user
POSTGRES_PASSWORD=
